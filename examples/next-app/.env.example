# SGAuth origin, read by server code (requireSession, getSession).
SGAUTH_URL=https://auth.dev.northeasternsga.com
# The same origin for client bundles. Only the URL builders run in the browser.
NEXT_PUBLIC_SGAUTH_URL=https://auth.dev.northeasternsga.com
# Dev SGAuth uses a different cookie name from production.
SGAUTH_COOKIE_NAME=__Secure-sgauth-dev.session_token
