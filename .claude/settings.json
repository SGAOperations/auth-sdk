{
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(npm *)",
      "Skill",
      "Bash(grep)",
      "Bash(grep *)",
      "Bash(find)",
      "Bash(find *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(wc)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(pwd *)",
      "Bash(mkdir -p *)",
      "Edit(**)",
      "Write(**)",
      "Read(~/.claude/plugins/**)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh issue delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh auth *)",
      "Bash(git push * main)",
      "Bash(git push origin main)",
      "Bash(git push *:main)",
      "Bash(npm publish *)",
      "Bash(npm login *)",
      "Bash(npm adduser *)"
    ]
  },
  "enabledPlugins": {
    "port@port": true
  },
  "extraKnownMarketplaces": {
    "port": {
      "source": {
        "source": "github",
        "repo": "b-at-neu/port",
        "ref": "v0.4.0"
      },
      "autoUpdate": true
    }
  }
}
