{
  "$schema": "https://raw.githubusercontent.com/b-at-neu/port/main/schema/port.config.schema.json",
  "tracker": "github",
  "repo": "SGAOperations/auth-sdk",
  "branches": {
    "integration": "main",
    "production": null
  },
  "commands": {
    "bootstrap": [],
    "checks": [],
    "artifacts": "node scripts/port-artifacts.mjs",
    "worktrees": "node scripts/port-worktrees.mjs",
    "budget": "node scripts/port-budget.mjs",
    "tick": null,
    "forensics": null
  },
  "docs": {
    "engineering": null,
    "design": null
  },
  "models": {
    "plan": "opus",
    "impl": "sonnet",
    "review": "sonnet",
    "revise": "sonnet"
  },
  "labels": {},
  "modules": {
    "approvalGate": true,
    "release": false,
    "scope": false
  },
  "release": {
    "postPublishHook": null
  },
  "reviewCycleCap": 5,
  "budget": {
    "wallClockMinutes": null
  },
  "concurrency": {
    "sharedFiles": [],
    "overlapThreshold": 2
  },
  "sessionRequiredPaths": [
    "CLAUDE.md",
    ".claude/**",
    "port.config.json"
  ],
  "extraAllow": [
    "Bash(node scripts/port-artifacts.mjs *)",
    "Bash(node scripts/port-worktrees.mjs *)",
    "Bash(node scripts/port-budget.mjs *)"
  ]
}
