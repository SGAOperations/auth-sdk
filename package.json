{
  "name": "@nusgaops/sgauth",
  "version": "0.1.0",
  "description": "Client SDK for SGAuth, the SGA Operations single sign-on service",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SGAOperations/auth-sdk.git"
  },
  "homepage": "https://github.com/SGAOperations/auth-sdk#readme",
  "bugs": {
    "url": "https://github.com/SGAOperations/auth-sdk/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./urls": {
      "import": {
        "types": "./dist/urls.d.ts",
        "default": "./dist/urls.js"
      },
      "require": {
        "types": "./dist/urls.d.cts",
        "default": "./dist/urls.cjs"
      }
    },
    "./proxy": {
      "import": {
        "types": "./dist/proxy.d.ts",
        "default": "./dist/proxy.js"
      },
      "require": {
        "types": "./dist/proxy.d.cts",
        "default": "./dist/proxy.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "browser": [
        "./dist/browser.d.ts"
      ],
      "urls": [
        "./dist/urls.d.ts"
      ],
      "proxy": [
        "./dist/proxy.d.ts"
      ],
      "next": [
        "./dist/next.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "schemas",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:package": "npm run build && publint --strict && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "next": "^16.4.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "server-only": "0.0.1"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
